# Copy manually to .env-miniapp-test; never copy the working .env.
MINI_APP_MODE=test
TEST_BOT_USERNAME=REPLACE_WITH_SEPARATE_TEST_BOT
TELEGRAM_BOT_TOKEN=REPLACE_LOCALLY_FROM_BOTFATHER
BOT_ADMIN_ID=REPLACE_WITH_OWNER_NUMERIC_TELEGRAM_ID
MINI_APP_ORIGIN=https://REPLACE_WITH_TEST_HOST
PERSONAL_DATA_POLICY_VERSION=REPLACE_WITH_CURRENT_POLICY_VERSION
PERSONAL_DATA_POLICY_URL=https://REPLACE_WITH_POLICY_URL
# Optional; without Google settings the API reports unavailable, never free/working.
# Use a separate calendar, never primary or the working calendar.
MINI_APP_CALENDAR_IS_TEST=false
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Server switch: false stops Mini App API commands; bot/worker remain independent.
MINI_APP_ENABLED=true
